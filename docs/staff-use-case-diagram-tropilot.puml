@startuml
title Tropilot — Staff Use-Case Diagram
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam defaultFontSize 21
skinparam titleFontSize 28
skinparam actorFontSize 22
skinparam usecaseFontSize 21
skinparam rectangleFontSize 23
skinparam packageFontSize 22
skinparam ArrowFontSize 16
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #3F4D63
}
skinparam package {
  BorderColor #8091A8
  BackgroundColor #F8FAFD
}

actor Staff

rectangle "Tropilot Rental Property Operations Management System" {
  package "Building Operations" #F2F9E9 {
    usecase "View assigned buildings\nand rooms" as UC1
    usecase "Record utility readings" as UC2
    usecase "View service fees" as UC3
    usecase "View equipment and\nmaintenance history" as UC4
    usecase "Review and generate\npermitted invoices" as UC5
    usecase "Review pending payments" as UC6
  }

  package "Work Assignment" #FFF3D6 {
    usecase "View assigned\nmaintenance requests" as UC7
    usecase "Start and complete\nassigned maintenance" as UC8
    usecase "View assigned tasks" as UC9
    usecase "Start and complete\nassigned tasks" as UC10
  }

  package "Staff Monitoring" #EAF2FF {
    usecase "View Staff dashboard" as UC11
    usecase "View activity logs" as UC12
  }
}

Staff -- UC1
Staff -- UC2
Staff -- UC3
Staff -- UC4
Staff -- UC5
Staff -- UC6
Staff -- UC7
Staff -- UC8
Staff -- UC9
Staff -- UC10
Staff -- UC11
Staff -- UC12

' Every association corresponds to a Staff-protected endpoint or explicitly
' shared Staff/Admin invoice, payment, or utility-reading endpoint.
@enduml
