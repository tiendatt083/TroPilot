direction: down

style: {
  font-size: 22
}

Users: "System Users" {
  direction: right
  style: {
    fill: "#F7F9FC"
    stroke: "#78909C"
    stroke-dash: 3
  }

  Administrator: Administrator {
    shape: person
    style.fill: "#E8F0FE"
  }
  Staff: Staff {
    shape: person
    style.fill: "#FFF4E5"
  }
  HeadResident: "Head Resident" {
    shape: person
    style.fill: "#F3E8FF"
  }
}

Presentation: "Tier 1 — Presentation Layer (React / Vite)" {
  direction: right
  style: {
    fill: "#EEF5FF"
    stroke: "#6E9FD4"
    stroke-dash: 3
  }

  ReactApp: "React 18 + Vite SPA" {
    icon: https://cdn.simpleicons.org/react/61DAFB
    style: {
      fill: "#FFFFFF"
      stroke: "#6E9FD4"
      shadow: true
    }
  }
  Router: "React Router\nProtected routes" { style.fill: "#FFFFFF" }
  State: "Theme Context, Hooks\nand Local Storage" { style.fill: "#FFFFFF" }
  Client: "Axios API Client\nREST requests" { style.fill: "#FFFFFF" }
}

Application: "Tier 2 — Application Layer (Spring Boot 3.2.4 / Java 17)" {
  direction: down
  style: {
    fill: "#FFF9DB"
    stroke: "#D2AE3A"
    stroke-dash: 3
  }

  RequestPipeline: "Request Processing" {
    direction: right
    Security: "Spring Security / JWT\nRBAC and room access control" { style.fill: "#FFFFFF" }
    Controllers: "REST Controllers\nValidation and request mapping" { style.fill: "#FFFFFF" }
    Services: "Business Service Layer\nRooms · contracts · invoices · payments\nmaintenance · tasks · notifications" {
      icon: https://cdn.simpleicons.org/springboot/6DB33F
      style: {
        fill: "#FFFFFF"
        stroke: "#90B95D"
        shadow: true
      }
    }
  }

  SupportComponents: "Persistence and Integration Support" {
    direction: right
    Persistence: "JPA Repositories, Entities,\nDTOs and Mappers" { style.fill: "#FFFFFF" }
    Adapters: "Integration and File Adapters\nGemini · SePay · SMTP · uploads" { style.fill: "#FFFFFF" }
  }
}

Dependencies: "Tier 3 — Data Layer and External Dependencies" {
  direction: down
  style: {
    fill: "#FFFFFF"
    stroke: "#B0BEC5"
    stroke-dash: 3
  }

  Data: "Data Layer" {
    direction: right
    style: {
      fill: "#F0FAEE"
      stroke: "#78B675"
      stroke-dash: 3
    }
    MySQL: "MySQL 8.4 Database" {
      shape: cylinder
      icon: https://cdn.simpleicons.org/mysql/4479A1
      style.fill: "#FFFFFF"
    }
    Flyway: "Flyway Migrations" { style.fill: "#FFFFFF" }
    Uploads: "Local Upload Storage\nContracts, proofs and images" {
      shape: document
      style.fill: "#FFFFFF"
    }
  }

  External: "External Services and Edge Access (outside system boundary)" {
    direction: right
    style: {
      fill: "#FFF3F0"
      stroke: "#D9978E"
      stroke-dash: 3
    }
    Gemini: "Gemini API\nRead-only AI chatbot" {
      icon: https://cdn.simpleicons.org/google/4285F4
      style.fill: "#FFFFFF"
    }
    SePay: "SePay\nPayment QR · webhook to API" {
      icon: https://cdn.simpleicons.org/visa/1A1F71
      style.fill: "#FFFFFF"
    }
    SMTP: "SMTP Email Service" {
      icon: https://cdn.simpleicons.org/gmail/EA4335
      style.fill: "#FFFFFF"
    }
    Cloudflare: "Cloudflare Tunnel\nOptional public access" { style.fill: "#FFFFFF" }
  }
}

Users -> Presentation: use web application
Presentation -> Application: REST API / JWT
Application -> Dependencies: JPA, file storage and external integrations
