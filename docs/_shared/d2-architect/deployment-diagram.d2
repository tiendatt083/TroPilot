direction: right

title: "Tropilot — Deployment Diagram"

classes: {
  boundary: {
    style: {
      fill: "#ffffff"
      stroke: "#94a3b8"
      stroke-dash: 3
      border-radius: 10
      font-color: "#0f172a"
    }
  }
  component: {
    style: {
      fill: "#ffffff"
      stroke: "#64748b"
      border-radius: 8
      font-color: "#0f172a"
    }
  }
  storage: {
    shape: cylinder
    style: {
      fill: "#ffffff"
      stroke: "#64748b"
      font-color: "#0f172a"
    }
  }
  external: {
    style: {
      fill: "#ffffff"
      stroke: "#94a3b8"
      border-radius: 8
      font-color: "#0f172a"
    }
  }
}

Client: "Client Device" {
  class: boundary
  Browser: "Web Browser\n(Administrator, Staff, Head Resident)" {
    class: component
  }
}

Frontend: "Frontend Environment" {
  class: boundary
  Vite: "React Frontend\nVite build / development server" {
    class: component
  }
  Note: "Production deployment uses the generated static build.\nVite serves the application during development." {
    shape: document
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
      font-color: "#475569"
    }
  }
}

Application: "Application Environment" {
  class: boundary
  SpringBoot: "Spring Boot Application\nREST API, security and business services" {
    class: component
  }
}

Storage: "Data and File Storage" {
  class: boundary
  MySQL: "MySQL Database\nFlyway migrations and JPA data" {
    class: storage
  }
  Uploads: "uploads/ directory\nContracts, payment proofs and images" {
    class: storage
  }
}

External: "External Services" {
  class: boundary
  SePay: "SePay\nQR payments and payment webhooks" {
    class: external
  }
  Gemini: "Gemini API\nAI assistant" {
    class: external
  }
  SMTP: "SMTP Email Service\nNotifications and password reset emails" {
    class: external
  }
}

Client.Browser -> Frontend.Vite: "loads React application"
Frontend.Vite -> Application.SpringBoot: "HTTPS / REST API"
Application.SpringBoot -> Storage.MySQL: "JPA / JDBC data access\nand Flyway migrations"
Application.SpringBoot -> Storage.Uploads: "stores and serves uploaded files"
Application.SpringBoot <-> External.SePay: "QR payment data and payment webhook"
Application.SpringBoot -> External.Gemini: "AI chat request"
Application.SpringBoot -> External.SMTP: "sends emails"
