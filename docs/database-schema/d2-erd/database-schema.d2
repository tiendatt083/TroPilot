direction: down

style: {
  font-size: 16
}

users: {
  shape: class
  + id: BIGINT <<PK>>
  + full_name: VARCHAR(120)
  + email: VARCHAR(120) <<UK>>
  + phone: VARCHAR(30)
  + password: VARCHAR(255)
  + role: VARCHAR(30)
  + status: VARCHAR(30)
  + created_at: DATETIME
  + updated_at: DATETIME
}

password_reset_codes: {
  shape: class
  + id: BIGINT <<PK>>
  + user_id: BIGINT <<FK>>
  + code: VARCHAR(20)
  + expires_at: DATETIME
  + used_at: DATETIME
}

buildings: {
  shape: class
  + id: BIGINT <<PK>>
  + building_code: VARCHAR(40) <<UK>>
  + name: VARCHAR(120)
  + address: VARCHAR(500)
  + floors: INT
  + created_at: DATETIME
  + updated_at: DATETIME
}

rooms: {
  shape: class
  + id: BIGINT <<PK>>
  + building_id: BIGINT <<FK>>
  + room_code: VARCHAR(40) <<UK>>
  + room_name: VARCHAR(120)
  + floor: INT
  + price: DECIMAL(12,2)
  + max_occupants: INT
  + status: VARCHAR(30)
}

room_assignments: {
  shape: class
  + id: BIGINT <<PK>>
  + room_id: BIGINT <<FK>>
  + resident_head_id: BIGINT <<FK>>
  + start_date: DATE
  + end_date: DATE
  + status: VARCHAR(30)
  + active_room_id: BIGINT <<UK, generated>>
  + active_resident_head_id: BIGINT <<UK, generated>>
}

room_members: {
  shape: class
  + id: BIGINT <<PK>>
  + room_id: BIGINT <<FK>>
  + resident_head_id: BIGINT <<FK>>
  + full_name: VARCHAR(120)
  + phone: VARCHAR(30)
  + email: VARCHAR(120)
  + status: VARCHAR(30)
  + move_in_date: DATE
  + move_out_date: DATE
}

vehicles: {
  shape: class
  + id: BIGINT <<PK>>
  + room_id: BIGINT <<FK>>
  + owner_name: VARCHAR(120)
  + owner_type: VARCHAR(30)
  + vehicle_type: VARCHAR(30)
  + license_plate: VARCHAR(30)
  + status: VARCHAR(30)
}

rental_contracts: {
  shape: class
  + id: BIGINT <<PK>>
  + room_id: BIGINT <<FK>>
  + resident_head_id: BIGINT <<FK>>
  + start_date: DATE
  + end_date: DATE
  + deposit_amount: DECIMAL(12,2)
  + rental_status: VARCHAR(30)
  + contract_status: VARCHAR(30)
}

rental_contract_file_histories: {
  shape: class
  + id: BIGINT <<PK>>
  + rental_contract_id: BIGINT <<FK>>
  + replaced_by_id: BIGINT <<FK>>
  + file_url: VARCHAR(500)
  + replaced_at: DATETIME
}

service_fees: {
  shape: class
  + id: BIGINT <<PK>>
  + building_id: BIGINT <<FK>>
  + fee_type: VARCHAR(30)
  + unit_price: DECIMAL(12,2)
  + is_active: BIT
  + active_electricity_building_id: BIGINT <<UK, generated>>
  + active_water_building_id: BIGINT <<UK, generated>>
}

utility_readings: {
  shape: class
  + id: BIGINT <<PK>>
  + room_id: BIGINT <<FK>>
  + created_by_id: BIGINT <<FK>>
  + reading_month: DATE <<UK with room_id>>
  + old_electricity: DECIMAL(12,2)
  + new_electricity: DECIMAL(12,2)
  + old_water: DECIMAL(12,2)
  + new_water: DECIMAL(12,2)
}

invoices: {
  shape: class
  + id: BIGINT <<PK>>
  + room_id: BIGINT <<FK>>
  + resident_head_id: BIGINT <<FK>>
  + created_by_id: BIGINT <<FK>>
  + invoice_month: DATE <<UK with room_id>>
  + invoice_date: DATE
  + due_date: DATE
  + total_amount: DECIMAL(12,2)
  + status: VARCHAR(30)
}

invoice_items: {
  shape: class
  + id: BIGINT <<PK>>
  + invoice_id: BIGINT <<FK>>
  + service_fee_id: BIGINT <<FK>>
  + item_type: VARCHAR(30)
  + amount: DECIMAL(12,2)
}

payments: {
  shape: class
  + id: BIGINT <<PK>>
  + invoice_id: BIGINT <<FK>>
  + resident_head_id: BIGINT <<FK>>
  + confirmed_by_id: BIGINT <<FK>>
  + amount: DECIMAL(12,2)
  + payment_method: VARCHAR(30)
  + status: VARCHAR(30)
}

receipts: {
  shape: class
  + id: BIGINT <<PK>>
  + invoice_id: BIGINT <<FK>>
  + resident_head_id: BIGINT <<FK>>
  + room_id: BIGINT <<FK>>
  + created_by_id: BIGINT <<FK>>
  + receipt_number: VARCHAR(50) <<UK>>
  + amount: DECIMAL(12,2)
}

sepay_payments: {
  shape: class
  + id: BIGINT <<PK>>
  + invoice_id: BIGINT <<FK>>
  + transaction_id: VARCHAR(100) <<UK>>
  + amount: DECIMAL(12,2)
  + status: VARCHAR(30)
}

equipment: {
  shape: class
  + id: BIGINT <<PK>>
  + building_id: BIGINT <<FK>>
  + room_id: BIGINT <<FK>>
  + name: VARCHAR(120)
  + condition: VARCHAR(30)
  + status: VARCHAR(30)
}

maintenance_requests: {
  shape: class
  + id: BIGINT <<PK>>
  + building_id: BIGINT <<FK, nullable>>
  + room_id: BIGINT <<FK, nullable>>
  + equipment_id: BIGINT <<FK>>
  + resident_head_id: BIGINT <<FK, nullable>>
  + requested_by_id: BIGINT <<FK, nullable>>
  + assigned_to_id: BIGINT <<FK, nullable>>
  + status: VARCHAR(30)
}

equipment_maintenance_history: {
  shape: class
  + id: BIGINT <<PK>>
  + equipment_id: BIGINT <<FK>>
  + maintenance_request_id: BIGINT <<FK>>
  + performed_by_id: BIGINT <<FK>>
  + performed_at: DATETIME
}

feedbacks: {
  shape: class
  + id: BIGINT <<PK>>
  + room_id: BIGINT <<FK>>
  + resident_head_id: BIGINT <<FK>>
  + invoice_id: BIGINT <<FK>>
  + replied_by_id: BIGINT <<FK>>
  + type: ENUM
  + status: ENUM(PENDING, IN_PROGRESS, RESOLVED)
}

tasks: {
  shape: class
  + id: BIGINT <<PK>>
  + building_id: BIGINT <<FK, nullable>>
  + room_id: BIGINT <<FK>>
  + feedback_id: BIGINT <<FK, nullable>>
  + assigned_to_id: BIGINT <<FK>>
  + created_by_id: BIGINT <<FK>>
  + task_type: ENUM
  + status: VARCHAR(30)
}

activity_logs: {
  shape: class
  + id: BIGINT <<PK>>
  + user_id: BIGINT <<FK>>
  + action: VARCHAR(100)
  + description: VARCHAR(1000)
  + created_at: DATETIME
}

notifications: {
  shape: class
  + id: BIGINT <<PK>>
  + created_by_id: BIGINT <<FK>>
  + title: VARCHAR(255)
  + target_type: VARCHAR(40)
  + source: VARCHAR(30)
  + event_type: VARCHAR(50)
  + action_path: VARCHAR(500)
}

notification_reads: {
  shape: class
  + id: BIGINT <<PK>>
  + notification_id: BIGINT <<FK>>
  + user_id: BIGINT <<FK>>
  + read_at: DATETIME
}

notification_target_buildings: {
  shape: class
  + id: BIGINT <<PK>>
  + notification_id: BIGINT <<FK>>
  + building_id: BIGINT <<FK>>
}

notification_target_users: {
  shape: class
  + id: BIGINT <<PK>>
  + notification_id: BIGINT <<FK>>
  + user_id: BIGINT <<FK>>
}

system_contacts: {
  shape: class
  + id: BIGINT <<PK>>
  + name: VARCHAR(120)
  + address: VARCHAR(500)
  + description: VARCHAR(1000)
}

system_contact_phones: {
  shape: class
  + id: BIGINT <<PK>>
  + system_contact_id: BIGINT <<FK>>
  + phone: VARCHAR(30)
}

# Final foreign keys: V1 baseline minus the dropped expenses table, plus V4, V5 and V6.
users.id -> password_reset_codes.user_id
users.id -> room_assignments.resident_head_id
rooms.id -> room_assignments.room_id
users.id -> room_members.resident_head_id
rooms.id -> room_members.room_id
rooms.id -> vehicles.room_id
users.id -> rental_contracts.resident_head_id
rooms.id -> rental_contracts.room_id
users.id -> rental_contract_file_histories.replaced_by_id
rental_contracts.id -> rental_contract_file_histories.rental_contract_id
buildings.id -> rooms.building_id
buildings.id -> service_fees.building_id
users.id -> utility_readings.created_by_id
rooms.id -> utility_readings.room_id
users.id -> invoices.resident_head_id
users.id -> invoices.created_by_id
rooms.id -> invoices.room_id
invoices.id -> invoice_items.invoice_id
service_fees.id -> invoice_items.service_fee_id
users.id -> payments.confirmed_by_id
users.id -> payments.resident_head_id
invoices.id -> payments.invoice_id
users.id -> receipts.resident_head_id
users.id -> receipts.created_by_id
rooms.id -> receipts.room_id
invoices.id -> receipts.invoice_id
invoices.id -> sepay_payments.invoice_id
buildings.id -> equipment.building_id
rooms.id -> equipment.room_id
users.id -> maintenance_requests.resident_head_id
users.id -> maintenance_requests.requested_by_id
users.id -> maintenance_requests.assigned_to_id
buildings.id -> maintenance_requests.building_id
rooms.id -> maintenance_requests.room_id
equipment.id -> maintenance_requests.equipment_id
maintenance_requests.id -> equipment_maintenance_history.maintenance_request_id
users.id -> equipment_maintenance_history.performed_by_id
equipment.id -> equipment_maintenance_history.equipment_id
rooms.id -> feedbacks.room_id
users.id -> feedbacks.resident_head_id
users.id -> feedbacks.replied_by_id
invoices.id -> feedbacks.invoice_id
rooms.id -> tasks.room_id
users.id -> tasks.assigned_to_id
users.id -> tasks.created_by_id
buildings.id -> tasks.building_id
feedbacks.id -> tasks.feedback_id
users.id -> activity_logs.user_id
users.id -> notifications.created_by_id
notifications.id -> notification_reads.notification_id
users.id -> notification_reads.user_id
notifications.id -> notification_target_buildings.notification_id
buildings.id -> notification_target_buildings.building_id
notifications.id -> notification_target_users.notification_id
users.id -> notification_target_users.user_id
system_contacts.id -> system_contact_phones.system_contact_id
